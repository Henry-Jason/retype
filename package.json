{
  "name": "retype",
  "private": true,
  "version": "0.1.0",
  "description": "An accuracy-first typing trainer: proofreader's marks, a till-roll receipt and weak-word practice.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-retype \"vitest run --config vitest.rules.config.js\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-retype",
    "dev:emulators": "vite --mode emulators"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "fake-indexeddb": "^6.0.0",
    "firebase-tools": "^13.35.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  }
}
