rules_version = '2';

// Each person can read and write only their own data:
//   users/{uid}                  the account document (bests, weak words, streak days, totals, top plays)
//   users/{uid}/results/{id}     one document per finished galley; never edited once written
//   users/{uid}/saved/quotes     your own quotes and favourites, so they follow you between devices
//   profiles/{uid}               a display name, public so boards can show it
//   boards/{board}/entries/{uid} leaderboard entries: anyone can read, only the Cloud Function
//                                (functions/index.js) writes, after re-checking the galley
//   quotes/{id}                  shared quotes: anyone can read approved ones, the submitter their
//                                own, admins everything; only the Cloud Functions write
//   admins/{uid}                 who reviews shared quotes; made by hand in the console
// Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{uid} {
      function validAccount(d) {
        return d.keys().hasOnly(['v', 'bests', 'weak', 'days', 'bestStreak', 'totals', 'folded', 'xp', 'top', 'feats', 'name', 'updated'])
          && d.v is int
          && d.bests is map
          && d.weak is map
          && d.days is list && d.days.size() <= 400
          && d.bestStreak is number && d.bestStreak >= 0
          && d.totals is map
          && (!('folded' in d) || (d.folded is list && d.folded.size() <= 300))
          && (!('xp' in d) || (d.xp is number && d.xp >= 0))
          && (!('top' in d) || (d.top is list && d.top.size() <= 100))
          && (!('feats' in d) || (d.feats is map && d.feats.size() <= 200))
          && (!('name' in d) || (d.name is string && d.name.size() <= 40));
      }

      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validAccount(request.resource.data);
      allow delete: if isOwner(uid);

      // your own quotes and favourites, merged between devices by the browser (core/quote-sync.js)
      match /saved/{doc} {
        function validSaved(d) {
          return doc == 'quotes'
            && d.keys().hasOnly(['v', 'quotes', 'deleted', 'favs', 'updated'])
            && d.quotes is list && d.quotes.size() <= 5000
            && d.deleted is map && d.deleted.size() <= 2000
            && d.favs is map && d.favs.size() <= 10000
            && d.updated is int;
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSaved(request.resource.data);
      }

      match /results/{rid} {
        function validResult(d) {
          return d.id == rid
            && d.userId == uid
            && d.at is int
            && d.kind in ['normal', 'mix', 'practice', 'code', 'daily', 'challenge', 'quote', 'dsurv', 'room']
            && d.wpm is number && d.wpm >= 0 && d.wpm < 1000
            && d.acc is number && d.acc >= 0 && d.acc <= 100
            && d.keys is string && d.keys.size() < 500000
            && d.targets is list && d.targets.size() <= 2000;
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validResult(request.resource.data);
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    match /profiles/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['name'])
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 20;
      }
      allow read: if true;
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /boards/{board}/entries/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /quotes/{id} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && resource.data.uid == request.auth.uid)
        || isAdmin();
      allow write: if false;
      match /reports/{uid} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
